# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI Key (Optional - Fallback rule parser activates if omitted)
GEMINI_API_KEY=

# Internal Worker Shared Secret (Secures Webhook communication)
TELEGRAM_WORKER_SECRET=placemint_super_secret_worker_token_2026

# AES-256 Secret for Telegram Session Strings
SESSION_ENCRYPTION_KEY=placemint_32_character_aes_secret_key!
